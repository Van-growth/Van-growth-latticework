# 배포 환경 구분 — dev/prod 여부 판단은 이 값으로 한다(NODE_ENV는 next build가 배포 환경과
# 무관하게 항상 production으로 잡아서 못 씀). 로컬 개발은 비워둬도 development로 기본 처리됨.
APP_ENV=development
NEXT_PUBLIC_APP_ENV=development

# Supabase
SUPABASE_URL=https://your-project.supabase.co
# service_role 키 — Dashboard > Project Settings > API > service_role (secret).
# RLS를 우회하므로 서버(server/.env)에만 두고 절대 클라이언트/NEXT_PUBLIC_로 노출하지 말 것.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key

# DART (금융감독원 전자공시시스템) — https://opendart.fss.or.kr
# 한국 기업 분석 시 공시 데이터 자동 주입. 없으면 web_search만 사용
DART_API_KEY=your-dart-api-key

# KIS (한국투자증권) Open API — https://apiportal.koreainvestment.com
# 한국 상장기업 시세/PER/PBR/시가총액. 없으면 생략
KIS_APP_KEY=your-kis-app-key
KIS_APP_SECRET=your-kis-app-secret

# FMP (Financial Modeling Prep) — https://financialmodelingprep.com
# 해외 기업 재무제표 (손익·B/S·C/F). 없으면 생략
FMP_API_KEY=your-fmp-api-key

# 프리미엄 내부 테스트 계정 우회 (Stripe 미연동 상태의 임시 수단) — 콤마 구분
# clientId(localStorage) 목록. profiles.is_premium_override와는 별도 경로.
PREMIUM_OVERRIDE_CLIENT_IDS=

# 관리자 계정 — 콤마 구분 auth.users.id 목록. typeahead(DART/EDGAR)에 없는 회사를
# 직접 입력해서 분석하는 기능 등 관리자 전용 기능에 사용. 프리미엄 플래그와는 별도 축.
ADMIN_USER_IDS=

# Server
PORT=4000
CLIENT_URL=http://localhost:3000

# Client (Next.js — prefix with NEXT_PUBLIC_ for browser access)
NEXT_PUBLIC_API_URL=http://localhost:4000
# 구글 로그인(Supabase Auth) — anon/publishable 키는 RLS로 보호되므로 공개돼도 안전.
# Dashboard > Project Settings > API 에서 확인.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Posthog — https://posthog.com (무료 티어) — 이벤트 트래킹 + 온보딩 설문 유저 속성 동기화.
# 없으면 client/src/lib/analytics.ts의 모든 함수가 조용히 no-op. dev/prod 반드시 별도 프로젝트 사용.
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-project-api-key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Microsoft Clarity — https://clarity.microsoft.com (무료) — 세션 리플레이 + 히트맵.
# 없으면 스크립트 자체가 삽입 안 됨. dev/prod 반드시 별도 프로젝트 사용.
NEXT_PUBLIC_CLARITY_ID=your-clarity-project-id
